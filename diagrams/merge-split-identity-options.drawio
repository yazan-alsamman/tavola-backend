<mxfile host="app.diagrams.net" modified="2026-07-25T22:00:00.000Z" agent="TAVOLA Merge/Split Architecture Freeze" version="22.1.0">
  <diagram id="merge-identity-options" name="Merge Identity Options">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Merge Tables — Reservable Identity (ADR-026 ARCHITECTURE FROZEN 2026-07-25)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="oA" value="Option A — Primary Table&#xa;&#xa;★ OWNER APPROVED / FROZEN (ADR-026)&#xa;&#xa;One existing Table becomes primary.&#xa;Others share mergeGroupId; status=Merged.&#xa;isMergePrimary marks the primary.&#xa;Reservation.tableId = primary.id&#xa;effectiveCapacity = SUM(member capacities)&#xa;&#xa;Fits existing Reservation.tableId FK.&#xa;Primary: optional primaryTableId else&#xa;lowest tableNumber then Table.id." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="360" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="oB" value="Option B — Synthetic Combination Table&#xa;&#xa;REJECTED&#xa;&#xa;Create new Table row for the combo.&#xa;Components marked Merged / hidden.&#xa;Reservation.tableId = synthetic.id&#xa;&#xa;New tableNumber namespace problem.&#xa;Historical cleanup on split." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="360" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="oC" value="Option C — TableCombination entity&#xa;&#xa;REJECTED&#xa;&#xa;New aggregate + Reservation FK change&#xa;or polymorphic target.&#xa;&#xa;Largest schema/API impact.&#xa;Contradicts current Reservation model." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="70" width="360" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="ADR-026 freeze: Split = undo merge only; topology advisory locks on sorted Table.ids before ADR-013/023 slot locks;&#xa;Move/Status forbidden while merged; dual-actor auth (Owner/Admin OR Employee tables:manage + branch); realtime → restaurant + branch rooms.&#xa;IMPLEMENTATION NOT STARTED / NOT YET AUTHORIZED." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1140" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
