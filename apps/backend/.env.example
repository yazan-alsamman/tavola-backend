# See docs/ENVIRONMENT_SETUP.md for the full explanation of every variable below.
# This file documents only the variables Foundation-phase infrastructure consumes.
# OneSignal variables are added to env.validation.ts and this file when their
# owning module is implemented.

NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://tavla:tavla@localhost:5432/tavla_dev
DATABASE_POOL_MODE=transaction
DATABASE_MAX_CONNECTIONS=10

REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB_INDEX=0
REDIS_QUEUE_DB_INDEX=1
REDIS_SOCKET_ADAPTER_DB_INDEX=2

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=tavla_minio_access
MINIO_SECRET_KEY=tavla_minio_secret
# Optional: only needed when the backend reaches MinIO over a hostname
# external clients can't resolve (e.g. running the backend itself in Docker
# Compose, where MINIO_ENDPOINT=minio). Unset here because this file assumes
# the backend runs on bare metal, where MINIO_ENDPOINT is already
# client-reachable. See docker/.env.development for the Docker Compose case.
# MINIO_PUBLIC_ENDPOINT=localhost
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false
MINIO_PUBLIC_BUCKET=tavla-public
MINIO_PRIVATE_BUCKET=tavla-private
MINIO_SIGNED_URL_EXPIRY_SECONDS=3600

# LOG_PRETTY should only ever be true for a bare-metal `pnpm start:dev`
# (outside Docker) - the Docker image is always the production build with
# pino-pretty (a devDependency) pruned; setting this true there crashes at
# boot. Never set true in a committed/shared env file.
LOG_LEVEL=info
LOG_PRETTY=false
CORRELATION_ID_HEADER=x-correlation-id
REQUEST_BODY_LIMIT=10mb
# Swagger is enabled by default in development/test/staging and disabled in production.
# Set SWAGGER_ENABLED=true explicitly to expose /api/v1/docs in production.
SWAGGER_ENABLED=

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
PLATFORM_ADMIN_JWT_SECRET=change-me-platform-admin-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Grace window (ms) for concurrent refresh retries before treating reuse as theft.
REFRESH_CONCURRENT_GRACE_MS=30000

# Redis sliding-window rate limits on auth endpoints (AUTHENTICATION_ARCHITECTURE.md §8.3).
# All have defaults matching the architecture table - only set these to override.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_CHANGE_PASSWORD_MAX=10
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900

# WhatsApp OTP delivery (ADR-022, provider updated to LightOTP by ADR-024).
# LIGHTOTP_API_KEY is a secret - set it only in a local, gitignored env file
# (e.g. .env.development), never here. See docs/ENVIRONMENT_SETUP.md.
LIGHTOTP_API_KEY=change-me-lightotp-api-key
LIGHTOTP_API_URL=https://api.lightotp.com/SendMessage
LIGHTOTP_REQUEST_TIMEOUT_MS=10000

# Owner Invite (Phase 19.8, ADR-036) - generic SMTP, vendor-neutral (works
# behind Amazon SES, Gmail, a SendGrid/Mailgun SMTP relay, self-hosted
# Postfix, or Mailhog/Ethereal for dev). SMTP_USER/SMTP_PASSWORD are secrets -
# set them only in a local, gitignored env file, never here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Tavla
SMTP_REQUEST_TIMEOUT_MS=10000
# Base URL used to build the invitation acceptance link sent by email.
APP_WEB_BASE_URL=http://localhost:3000

# ADR-034 §10 (H1 remediation) — operational bootstrap for the very first
# PlatformAdmin account, consumed only by `prisma/seed.ts`. Optional: leave
# all four unset (the default here) on every environment that already has a
# PlatformAdmin — `prisma db seed` is then a no-op for this row. Set all
# four only on a fresh database with no PlatformAdmin yet, run the seed
# once, then unset/rotate the password out-of-band.
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=
# PLATFORM_ADMIN_BOOTSTRAP_FIRST_NAME=
# PLATFORM_ADMIN_BOOTSTRAP_LAST_NAME=
