// See docs/DATABASE_SCHEMA.md — Phase 2.1 database foundation (19 models).
// Governance: ARCHITECTURE_LOCK.md, MIGRATION_POLICY.md
// Phase 1 SystemConfiguration table retained unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (values documented in DATABASE_SCHEMA.md / AUTHENTICATION_ARCHITECTURE.md)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  Active
  Suspended
  Closed
}

enum OrganizationMemberRole {
  Owner
  Admin
  Billing
  Staff
}

enum OrganizationMemberStatus {
  Invited
  Active
  Removed
}

enum UserStatus {
  Pending
  Active
  Suspended
  Locked
  Deleted
  Anonymized
}

enum DeviceType {
  mobile
  web
  tablet
  unknown
}

enum SessionRevokeReason {
  logout
  reuse_detected
  password_change
  admin
  expired
  session_version_bump
}

enum RoleScope {
  Platform
  Restaurant
}

enum RolePermissionType {
  RoleGrant
  IndividualGrant
  IndividualRevocation
}

enum AuditActorType {
  User
  Employee
  System
}

enum ConsentType {
  TermsOfService
  PrivacyPolicy
  Marketing
}

enum FileOwnerType {
  User
  Restaurant
  Review
  Menu
}

enum FileAccessPolicy {
  Public
  Private
}

// ---------------------------------------------------------------------------
// Core tenant & identity
// ---------------------------------------------------------------------------

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String
  status       OrganizationStatus @default(Active)
  billingEmail String             @map("billing_email")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  members     OrganizationMember[]
  restaurants Restaurant[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  role           OrganizationMemberRole
  invitedAt      DateTime?                @map("invited_at")
  joinedAt       DateTime?                @map("joined_at")
  status         OrganizationMemberStatus @default(Invited)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String
  phone              String?
  passwordHash       String     @map("password_hash")
  avatarId           String?    @map("avatar_id") @db.Uuid
  language           String
  preferredCurrency  String?    @map("preferred_currency")
  notificationOptIn  Boolean    @default(true) @map("notification_opt_in")
  marketingOptIn     Boolean    @default(false) @map("marketing_opt_in")
  status             UserStatus @default(Pending)
  emailVerified      Boolean    @default(false) @map("email_verified")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  permissionsVersion Int        @default(1) @map("permissions_version")
  sessionVersion     Int        @default(1) @map("session_version")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  anonymizedAt       DateTime?  @map("anonymized_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  organizationMembers     OrganizationMember[]
  deviceSessions          DeviceSession[]
  tokenFamilies           TokenFamily[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  passwordHistory         PasswordHistory[]
  userConsents            UserConsent[]
  platformAdmin           PlatformAdmin?
  employees               Employee[]
  favorites               Favorite[]

  @@unique([email])
  @@index([phone])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model TokenFamily {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  compromisedAt DateTime? @map("compromised_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSessions DeviceSession[]

  @@index([userId])
  @@index([compromisedAt])
  @@map("token_families")
}

model DeviceSession {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @map("user_id") @db.Uuid
  tokenFamilyId            String               @map("token_family_id") @db.Uuid
  refreshTokenHash         String               @map("refresh_token_hash")
  previousRefreshTokenHash String?              @map("previous_refresh_token_hash")
  deviceName               String?              @map("device_name")
  deviceType               DeviceType           @default(unknown) @map("device_type")
  ipAddress                String?              @map("ip_address")
  userAgent                String?              @map("user_agent")
  sessionVersion           Int                  @map("session_version")
  permissionsVersion       Int                  @map("permissions_version")
  lastUsedAt               DateTime?            @map("last_used_at")
  revokedAt                DateTime?            @map("revoked_at")
  revokedReason            SessionRevokeReason? @map("revoked_reason")
  expiresAt                DateTime             @map("expires_at")
  createdAt                DateTime             @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily TokenFamily @relation(fields: [tokenFamilyId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([tokenFamilyId])
  @@index([previousRefreshTokenHash])
  @@map("device_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  identifier    String
  ipAddress     String   @map("ip_address")
  success       Boolean
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([identifier])
  @@index([createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model UserConsent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  consentType  ConsentType @map("consent_type")
  termsVersion String      @map("terms_version")
  consentedAt  DateTime    @map("consented_at")
  ipAddress    String      @map("ip_address")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

model PlatformAdmin {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Restaurant structure (foundation — no business data seeded)
// ---------------------------------------------------------------------------

model Restaurant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  slug           String
  logoId         String?   @map("logo_id") @db.Uuid
  coverImageId   String?   @map("cover_image_id") @db.Uuid
  description    String?
  cuisineType    String?   @map("cuisine_type")
  averageRating  Decimal?  @map("average_rating") @db.Decimal(3, 2)
  priceLevel     Int?      @map("price_level")
  status         String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  employees    Employee[]
  favorites    Favorite[]
  settings     RestaurantSettings?
  workingHours WorkingHours[]

  @@index([organizationId])
  @@index([slug])
  @@index([name])
  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// Restaurant Settings (Phase 4.2 — Restaurant Module, DATABASE_SCHEMA.md
// "Restaurant Settings"). Tenant-owned transitively via restaurantId ->
// Restaurant.organizationId, not directly - deliberately NOT added to
// withTenantScoping's DIRECT_TENANT_OWNED_MODELS (see that extension's own
// doc comment: relation-path enforcement is deferred to whichever phase
// implements the first consuming repository; enforced at the application
// layer instead - every use case resolves the parent Restaurant through the
// already-tenant-scoped RestaurantRepository first. See
// PrismaRestaurantSettingsRepository's own doc comment.
// ---------------------------------------------------------------------------

model RestaurantSettings {
  id                               String   @id @default(uuid()) @db.Uuid
  restaurantId                     String   @unique @map("restaurant_id") @db.Uuid
  reservationIntervalMinutes       Int      @default(30) @map("reservation_interval_minutes")
  maxGuestsPerReservation          Int      @default(20) @map("max_guests_per_reservation")
  cancellationWindowMinutes        Int      @default(60) @map("cancellation_window_minutes")
  pendingReservationTimeoutMinutes Int      @default(15) @map("pending_reservation_timeout_minutes")
  autoApproval                     Boolean  @default(false) @map("auto_approval")
  timezone                         String   @default("UTC")
  defaultCurrency                  String?  @map("default_currency")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

// ---------------------------------------------------------------------------
// Working Hours (Phase 4.3 — Restaurant Module, DATABASE_SCHEMA.md
// "Working Hours"). Restaurant-level default only per this phase's explicit
// architecture decision (2026-07-16): DOMAIN_MODEL.md's Restaurant Aggregate
// child-entity list is authoritative for aggregate ownership in Phase 4;
// branch-level override (`branchId`, composite override lookup) is deferred
// to Phase 5 when the Branch aggregate/module is implemented and will be
// added as a separate, additive migration then. Tenant-owned transitively
// via restaurantId -> Restaurant.organizationId, not directly - deliberately
// NOT added to withTenantScoping's DIRECT_TENANT_OWNED_MODELS, same pattern
// as RestaurantSettings (see that model's own comment above).
// ---------------------------------------------------------------------------

model WorkingHours {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  openingTime    String   @map("opening_time")
  closingTime    String   @map("closing_time")
  breakStartTime String?  @map("break_start_time")
  breakEndTime   String?  @map("break_end_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("working_hours")
}

// ---------------------------------------------------------------------------
// Favorites (Phase 3.3 — User Module, DATABASE_SCHEMA.md "Favorites")
// ---------------------------------------------------------------------------

/**
 * `FavoriteRestaurant` in DOMAIN_MODEL.md (a child entity of the User
 * aggregate). Deliberately NOT added to the tenant-scoping extension's
 * `DIRECT_TENANT_OWNED_MODELS`/relation-path allowlist even though
 * `restaurantId` transitively chains to `Restaurant.organizationId`: every
 * query here is scoped by the caller's own verified `userId` (never by
 * `organizationId`), so the security boundary is "only your own favorites",
 * identical in kind to `PrismaLoginOrganizationReader`'s documented
 * exception. No production code path lets an Organization read another
 * user's Favorites through this model, so there is no cross-tenant leakage
 * surface to enforce against. See `prisma-favorite-restaurant.repository.ts`.
 */
model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("favorites")
}

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  city         String
  district     String?
  address      String
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  countryCode  String    @map("country_code")
  currency     String?
  openingHours Json?     @map("opening_hours")
  timezone     String
  phone        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  restaurant                Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employeeBranchAssignments EmployeeBranchAssignment[]

  @@index([restaurantId])
  @@index([city])
  @@index([countryCode])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Authorization (RBAC)
// ---------------------------------------------------------------------------

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String
  scope       RoleScope
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employees       Employee[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String             @id @default(uuid()) @db.Uuid
  roleId       String?            @map("role_id") @db.Uuid
  employeeId   String?            @map("employee_id") @db.Uuid
  permissionId String             @map("permission_id") @db.Uuid
  type         RolePermissionType
  createdAt    DateTime           @default(now()) @map("created_at")

  role       Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([employeeId])
  @@map("role_permissions")
}

model Employee {
  id                 String    @id @default(uuid()) @db.Uuid
  restaurantId       String    @map("restaurant_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  permissionsVersion Int       @default(1) @map("permissions_version")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String
  phone              String?
  status             String
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  restaurant        Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role              Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchAssignments EmployeeBranchAssignment[]
  rolePermissions   RolePermission[]

  @@index([restaurantId])
  @@index([email])
  @@map("employees")
}

model EmployeeBranchAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  assignedAt DateTime @map("assigned_at")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branch_assignments")
}

// ---------------------------------------------------------------------------
// Files (Phase 3.2 — avatar upload; generic file metadata for any owner)
// ---------------------------------------------------------------------------

// Metadata only - actual bytes live in MinIO (DATABASE_SCHEMA.md "Files").
// ownerId/ownerType is a polymorphic reference (no Prisma relation, same
// pattern as Restaurant.logoId/coverImageId) since ownerType varies across
// unrelated tables. No updatedAt: rows are immutable metadata records -
// replacement creates a new row rather than mutating an existing one
// (matches the AuditLog/LoginAttempt precedent above).
model File {
  id           String           @id @default(uuid()) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  ownerType    FileOwnerType    @map("owner_type")
  bucket       String
  objectKey    String           @map("object_key")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  accessPolicy FileAccessPolicy @map("access_policy")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")

  @@index([ownerType, ownerId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Audit (Phase 2.18 — authentication audit log writes)
// ---------------------------------------------------------------------------

// Immutable — rows are never updated or deleted (DATABASE_SCHEMA.md "Audit
// Logs": "Stores all important actions... never updated or deleted"), hence
// no `updatedAt` column (matches the `LoginAttempt` precedent above).
model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  organizationId String?        @map("organization_id") @db.Uuid
  correlationId  String?        @map("correlation_id")
  ipAddress      String?        @map("ip_address")
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  @@index([targetType, targetId])
  @@index([organizationId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Platform configuration (Phase 1 — table name retained)
// ---------------------------------------------------------------------------

model SystemConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}
