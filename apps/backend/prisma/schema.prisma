// ---------------------------------------------------------------------------
// Subscriptions (Phase 12, architecture frozen 2026-07-28, ADR-027).
// Entitlement/access-contract system - NOT billing (TAVLA does not process
// payments, ADR-021 Disposition). No price/billing-cycle fields anywhere in
// this section.
//
// SubscriptionPlan is platform-global reference data (TENANCY.md, alongside
// Country/Currency/Roles) - no organizationId column, seed-managed only (no
// runtime write API in Phase 12).
//
// Subscription and SubscriptionUsage are directly Organization-owned
// (organizationId, unique) - added to withTenantScoping's
// DIRECT_TENANT_OWNED_MODELS.
//
// RestaurantUsage is transitively tenant-owned via
// restaurantId -> Restaurant.organizationId (same pattern as
// RestaurantSettings/RestaurantGallery/Offer) - deliberately NOT added to
// DIRECT_TENANT_OWNED_MODELS. It exists because maxBranchesPerRestaurant/
// maxEmployeesPerRestaurant are PER-RESTAURANT limits: a single
// Organization-scoped counter cannot tell which specific Restaurant is over
// its own cap (ADR-027's core reconciliation).
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  Active
  Suspended
  Cancelled
  Expired
}

model SubscriptionPlan {
  id                        String    @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String
  maxRestaurants            Int       @map("max_restaurants")
  maxBranchesPerRestaurant  Int       @map("max_branches_per_restaurant")
  maxEmployeesPerRestaurant Int       @map("max_employees_per_restaurant")
  archivedAt                DateTime? @map("archived_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@unique([name])
  @@unique([slug])
  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  subscriptionPlanId String             @map("subscription_plan_id") @db.Uuid
  status             SubscriptionStatus @default(Active)
  startsAt           DateTime           @map("starts_at")
  endsAt             DateTime?          @map("ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  @@index([subscriptionPlanId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  restaurantCount Int      @default(0) @map("restaurant_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscription_usage")
}

model RestaurantUsage {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @unique @map("restaurant_id") @db.Uuid
  branchCount   Int      @default(0) @map("branch_count")
  employeeCount Int      @default(0) @map("employee_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_usage")
}

// ---------------------------------------------------------------------------
// Authorization (RBAC)
// ---------------------------------------------------------------------------

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String
  scope       RoleScope
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employees       Employee[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String             @id @default(uuid()) @db.Uuid
  roleId       String?            @map("role_id") @db.Uuid
  employeeId   String?            @map("employee_id") @db.Uuid
  permissionId String             @map("permission_id") @db.Uuid
  type         RolePermissionType
  createdAt    DateTime           @default(now()) @map("created_at")

  role       Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([employeeId])
  @@map("role_permissions")
}

model Employee {
  id                 String    @id @default(uuid()) @db.Uuid
  restaurantId       String    @map("restaurant_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  permissionsVersion Int       @default(1) @map("permissions_version")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String
  phone              String?
  status             String
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  restaurant               Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role                     Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchAssignments        EmployeeBranchAssignment[]
  rolePermissions          RolePermission[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  @@index([restaurantId])
  @@index([email])
  @@index([userId])
  @@index([roleId])
  @@map("employees")
}

model EmployeeBranchAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  assignedAt DateTime @map("assigned_at")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branch_assignments")
}

// ---------------------------------------------------------------------------
// Files (Phase 3.2 — avatar upload; generic file metadata for any owner)
// ---------------------------------------------------------------------------

// Metadata only - actual bytes live in MinIO (DATABASE_SCHEMA.md "Files").
// ownerId/ownerType is a polymorphic reference (no Prisma relation, same
// pattern as Restaurant.logoId/coverImageId) since ownerType varies across
// unrelated tables. No updatedAt: rows are immutable metadata records -
// replacement creates a new row rather than mutating an existing one
// (matches the AuditLog/LoginAttempt precedent above).
model File {
  id           String           @id @default(uuid()) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  ownerType    FileOwnerType    @map("owner_type")
  bucket       String
  objectKey    String           @map("object_key")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  accessPolicy FileAccessPolicy @map("access_policy")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")

  @@index([ownerType, ownerId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Audit (Phase 2.18 — authentication audit log writes)
// ---------------------------------------------------------------------------

// Immutable — rows are never updated or deleted (DATABASE_SCHEMA.md "Audit
// Logs": "Stores all important actions... never updated or deleted"), hence
// no `updatedAt` column (matches the `LoginAttempt` precedent above).
model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  organizationId String?        @map("organization_id") @db.Uuid
  correlationId  String?        @map("correlation_id")
  ipAddress      String?        @map("ip_address")
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  @@index([targetType, targetId])
  @@index([organizationId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Platform configuration (Phase 1 — table name retained)
// ---------------------------------------------------------------------------

model SystemConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Notifications (Phase 9 — Notification System, architecture frozen
// 2026-07-25, TASKS.md's "Phase 9 — Notification System: Pre-implementation
// architecture decisions"). `Notification` is `userId`-owned only (decision
// item 2 — no Employee/OrganizationMember/ReservationGuest recipient exists
// in v1) and carries no direct `organizationId` (decision item 13 — a
// Customer's notification inbox spans every organization they've ever booked
// with, exactly like `Reservation.userId` itself; mirrors the Phase 7.5
// `ReservationWaitlistEntry.organizationId` correction). Deliberately NOT
// added to `withTenantScoping`'s `DIRECT_TENANT_OWNED_MODELS` — see
// TENANCY.md. Read (`read`/`readAt`) and push (`pushStatus`/`pushSentAt`/
// `pushFailedAt`) are two independent state tracks on one row (decision item
// 5) — no separate lifecycle-event chain, no `Delivered` state (OneSignal's
// Send API only proves provider acceptance, never on-device delivery).
// ---------------------------------------------------------------------------

enum NotificationPushStatus {
  NotAttempted
  Queued
  Accepted
  Failed
}

enum NotificationChannel {
  Push
  InApp
  SMS
}

/**
 * `templateId` is traceability only — `title`/`body` are resolved and
 * snapshotted at creation time in the recipient's language and are never
 * re-read from the template for rendering (decision item 4), so an edited or
 * deleted template never changes a Customer's notification history. No
 * `deletedAt` (retention undecided/deferred, additive later without
 * migration risk) and no `retryCount` (BullMQ's own per-job `attempts`
 * configuration is the retry-count authority, not a column on this row).
 */
model Notification {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  type                  String
  templateId            String?                @map("template_id") @db.Uuid
  title                 String
  body                  String
  data                  Json?
  read                  Boolean                @default(false)
  readAt                DateTime?              @map("read_at")
  pushStatus            NotificationPushStatus @default(NotAttempted) @map("push_status")
  pushSentAt            DateTime?              @map("push_sent_at")
  pushFailedAt          DateTime?              @map("push_failed_at")
  pushFailureReason     String?                @map("push_failure_reason")
  pushIdempotencyKey    String?                @map("push_idempotency_key") @db.Uuid
  pushProviderMessageId String?                @map("push_provider_message_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

/**
 * Platform-global only (decision item 15 — no restaurant-specific override,
 * no versioning). `SMS` remains present in `channel` purely as documented
 * schema foresight (`NON_FUNCTIONAL_REQUIREMENTS.md`) — not implemented
 * against; no SMS template content or delivery code exists in Phase 9 v1.
 * `isDefault` marks the fallback used when no translation exists for the
 * recipient's resolved `User.language` (LOCALIZATION.md).
 */
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  eventType String              @map("event_type")
  language  String
  channel   NotificationChannel
  title     String
  body      String
  isDefault Boolean             @default(false) @map("is_default")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  notifications Notification[]

  @@unique([eventType, language, channel])
  @@index([eventType, channel, isDefault])
  @@map("notification_templates")
}

// ---------------------------------------------------------------------------
// Messaging (Phase 15.6 — Customer-Restaurant Messaging, ADR-020, tenancy
// corrected by ADR-030; DECISIONS.md's Phase 15.6 Owner Decisions D1-D15).
//
// Tenant-owned TRANSITIVELY via restaurantId -> Restaurant.organizationId
// (D1/ADR-030) - deliberately NOT added to withTenantScoping's
// DIRECT_TENANT_OWNED_MODELS, exactly like Branch/Reservation/Review/Offer
// (TENANCY.md). No organizationId column on any of the three tables below.
// Every use case must resolve the parent Restaurant via the already-tenant-
// scoped RestaurantRepository first - a cross-organization restaurantId
// resolves to null -> RestaurantNotFoundException/ConversationNotFoundException,
// IDOR-safe like every other transitively-tenant-owned model.
//
// ConversationParticipant is per-individual (D2): a Customer row always sets
// userId; a Staff row set by an Employee sets employeeId, set by an
// OrganizationMember sets userId instead (there is no Employee row for an
// OrganizationMember) - Message.senderType is what disambiguates a bare
// userId between the Customer and OrganizationMember cases.
//
// The (conversationId, userId)/(conversationId, employeeId) partial unique
// indexes and the senderUserId/senderEmployeeId XOR CHECK on Message cannot
// be expressed in Prisma's schema language - added via raw SQL in this
// phase's migration, exactly like Reservation/ReservationWaitlistEntry's own
// userId/reservationGuestId XOR constraints.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  Open
  Closed
  Archived
}

enum ConversationParticipantRole {
  Customer
  Staff
  System
}

enum MessageSenderType {
  Customer
  Employee
  OrganizationMember
  System
}

enum MessageType {
  Text
  System
  Attachment
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  restaurantId  String             @map("restaurant_id") @db.Uuid
  branchId      String?            @map("branch_id") @db.Uuid
  reservationId String?            @map("reservation_id") @db.Uuid
  subject       String?
  status        ConversationStatus @default(Open)
  lastMessageAt DateTime?          @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch       Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reservation  Reservation?              @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([reservationId])
  @@index([restaurantId, lastMessageAt])
  // Cursor pagination (D13) sorts/pages by updatedAt, not the nullable
  // lastMessageAt above - updatedAt is never null and is bumped on every
  // meaningful mutation (create/send/close/archive), avoiding NULLS LAST
  // row-value comparison complexity a nullable cursor column would require.
  @@index([restaurantId, updatedAt])
  @@index([status])
  @@map("conversations")
}

model ConversationParticipant {
  id             String                      @id @default(uuid()) @db.Uuid
  conversationId String                      @map("conversation_id") @db.Uuid
  userId         String?                     @map("user_id") @db.Uuid
  employeeId     String?                     @map("employee_id") @db.Uuid
  role           ConversationParticipantRole
  lastReadAt     DateTime?                   @map("last_read_at")
  joinedAt       DateTime                    @default(now()) @map("joined_at")
  leftAt         DateTime?                   @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([employeeId])
  @@map("conversation_participants")
}

model Message {
  id               String            @id @default(uuid()) @db.Uuid
  conversationId   String            @map("conversation_id") @db.Uuid
  senderType       MessageSenderType @map("sender_type")
  senderUserId     String?           @map("sender_user_id") @db.Uuid
  senderEmployeeId String?           @map("sender_employee_id") @db.Uuid
  body             String
  messageType      MessageType       @default(Text) @map("message_type")
  attachmentFileId String?           @map("attachment_file_id") @db.Uuid
  anonymizedAt     DateTime?         @map("anonymized_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderEmployee Employee?    @relation(fields: [senderEmployeeId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}
