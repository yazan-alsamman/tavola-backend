// See docs/DATABASE_SCHEMA.md — Phase 2.1 database foundation (19 models).
// Governance: ARCHITECTURE_LOCK.md, MIGRATION_POLICY.md
// Phase 1 SystemConfiguration table retained unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (values documented in DATABASE_SCHEMA.md / AUTHENTICATION_ARCHITECTURE.md)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  Active
  Suspended
  Closed
}

enum OrganizationMemberRole {
  Owner
  Admin
  Billing
  Staff
}

enum OrganizationMemberStatus {
  Invited
  Active
  Removed
}

enum UserStatus {
  Pending
  Active
  Suspended
  Locked
  Deleted
  Anonymized
}

/**
 * Status Management architecture decision (TASKS.md "Phase 6 — Status
 * Management" note): `Create Table` always produces `Available`. Manual
 * transitions happen exclusively through the single dedicated Domain Action
 * `POST /tables/{tableId}/status`, restricted to `Available <-> Occupied`/
 * `Available <-> Cleaning`/`Available <-> Disabled` only - every other
 * combination is rejected. `Update Table` never transitions status.
 * `Reserved` (Phase 7.2 — Approval Workflow, architecture frozen 2026-07-20)
 * is exclusively a Reservation Engine concept - only `Table.reserve()`/
 * `Table.release()` may set or clear it; `Table.transitionStatus`/
 * `POST /tables/{tableId}/status` continue to reject it entirely. `Merged`
 * (ADR-026, Merge/Split Tables architecture freeze 2026-07-25) is exclusively
 * a Merge/Split concept - only `Table.asMergeSecondary()`/
 * `Table.clearMergeMembership()` may set/clear it on a secondary merge
 * member; `Table.transitionStatus`/`POST /tables/{tableId}/status` reject it
 * entirely, exactly like `Reserved`. A merge primary keeps using
 * `Available`/`Reserved` via the existing `reserve()`/`release()` methods -
 * `Merged` is never set on a primary.
 */
enum TableStatus {
  Available
  Occupied
  Cleaning
  Disabled
  Reserved
  Merged
}

/**
 * Phase 6.1 architecture decision (TASKS.md Phase 6.1 decision #7):
 * presentation metadata only - describes floor-plan rendering, no bearing on
 * reservation rules, capacity, or merge/split behavior. Intentionally
 * minimal: a square table is represented as `Rectangle` with `width ==
 * height`, not a separate value. Any additional shape requires its own
 * future explicit architectural decision.
 */
enum TableShape {
  Rectangle
  Round
}

enum DeviceType {
  mobile
  web
  tablet
  unknown
}

enum SessionRevokeReason {
  logout
  reuse_detected
  password_change
  admin
  expired
  session_version_bump
  // Phase 20.X - RequestAccountDeletionUseCase's immediate revoke-everything
  // call. Distinct from `admin` (PlatformAdmin-initiated) and
  // `password_change` (self-service but not deletion-related).
  account_deletion
}

enum RoleScope {
  Platform
  Restaurant
}

enum RolePermissionType {
  RoleGrant
  IndividualGrant
  IndividualRevocation
}

enum AuditActorType {
  User
  Employee
  System
  PlatformAdmin
}

/**
 * ADR-034 §11 — two-tier Platform role. `PlatformSupport` is read-only
 * (no Suspend/Delete/Restore/Reversal/Manual-Record/Credential-Reset/
 * pricing-mutation authority anywhere this enum is checked).
 */
enum PlatformAdminRole {
  PlatformAdmin
  PlatformSupport
}

enum ConsentType {
  TermsOfService
  PrivacyPolicy
  Marketing
}

enum FileOwnerType {
  User
  Restaurant
  Review
  Menu
  // Phase 15.6 (Messaging, DECISIONS.md D7): chat attachments. Same
  // polymorphic ownerId/ownerType convention as every other value here - no
  // Prisma relation, resolved by the application layer.
  Message
}

enum FileAccessPolicy {
  Public
  Private
}

// ---------------------------------------------------------------------------
// Core tenant & identity
// ---------------------------------------------------------------------------

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String
  status       OrganizationStatus @default(Active)
  billingEmail String             @map("billing_email")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  members           OrganizationMember[]
  restaurants       Restaurant[]
  subscription      Subscription?
  subscriptionUsage SubscriptionUsage?

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  role           OrganizationMemberRole
  invitedAt      DateTime?                @map("invited_at")
  joinedAt       DateTime?                @map("joined_at")
  status         OrganizationMemberStatus @default(Invited)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model User {
  id                       String     @id @default(uuid()) @db.Uuid
  // ADR-022: nullable — Customer registration never collects a name (the
  // frozen identity is username + phone + password only); mechanically the
  // same nullable-per-actor-field pattern already approved for
  // email/phone/username, extended here since ADR-022 never enumerated
  // firstName/lastName explicitly but the shared-User-table constraint is
  // identical.
  firstName                String?    @map("first_name")
  lastName                 String?    @map("last_name")
  // ADR-022: nullable — required in practice only for administratively-
  // provisioned Restaurant Owner/staff accounts; never collected for
  // customer registration. Plain @unique on a nullable column already
  // permits multiple NULLs in PostgreSQL, so no actor discriminator or
  // partial index is needed (DECISIONS.md ADR-022 Decision #9).
  email                    String?
  // ADR-022: canonical E.164, required in practice only for customer
  // accounts; unique-where-not-null for the same reason as email above.
  phone                    String?
  // ADR-022 Decision #9/#14: customer identity attribute, stored lowercased
  // (mirrors the existing OrganizationSlug normalize-then-unique-index
  // precedent, application-layer.util.ts) so the plain unique index below
  // enforces case-insensitive uniqueness without a citext extension.
  username                 String?    @map("username")
  passwordHash             String     @map("password_hash")
  avatarId                 String?    @map("avatar_id") @db.Uuid
  language                 String
  preferredCurrency        String?    @map("preferred_currency")
  notificationOptIn        Boolean    @default(true) @map("notification_opt_in")
  marketingOptIn           Boolean    @default(false) @map("marketing_opt_in")
  status                   UserStatus @default(Pending)
  emailVerified            Boolean    @default(false) @map("email_verified")
  failedLoginCount         Int        @default(0) @map("failed_login_count")
  lockedUntil              DateTime?  @map("locked_until")
  permissionsVersion       Int        @default(1) @map("permissions_version")
  sessionVersion           Int        @default(1) @map("session_version")
  passwordChangedAt        DateTime?  @map("password_changed_at")
  lastLoginAt              DateTime?  @map("last_login_at")
  anonymizedAt             DateTime?  @map("anonymized_at")
  // Phase 20.X (ADR-014 execution) - set together by RequestAccountDeletion,
  // cleared together by CancelAccountDeletion. Deliberately flat columns on
  // User rather than a separate request table, mirroring how every other
  // scheduled-future-transition already lives directly on its owning
  // aggregate (Subscription.endsAt). `status` stays Active throughout the
  // grace period - only these two timestamps track a pending request - so
  // the account remains loggable-in (required to reach Cancel, since
  // requesting deletion already revokes every session/token immediately).
  deletionRequestedAt      DateTime?  @map("deletion_requested_at")
  scheduledAnonymizationAt DateTime?  @map("scheduled_anonymization_at")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  deletedAt                DateTime?  @map("deleted_at")

  organizationMembers         OrganizationMember[]
  deviceSessions              DeviceSession[]
  tokenFamilies               TokenFamily[]
  passwordResetTokens         PasswordResetToken[]
  customerPasswordResetTokens CustomerPasswordResetToken[]
  passwordHistory             PasswordHistory[]
  userConsents                UserConsent[]
  platformAdmin               PlatformAdmin?
  employees                   Employee[]
  favorites                   Favorite[]
  reservations                Reservation[]
  waitlistEntries             ReservationWaitlistEntry[]
  notifications               Notification[]
  reviews                     Review[]
  restaurantReplies           RestaurantReply[]
  conversationParticipants    ConversationParticipant[]
  sentMessages                Message[]

  @@unique([email])
  @@unique([phone])
  @@unique([username])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model TokenFamily {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  compromisedAt DateTime? @map("compromised_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSessions DeviceSession[]

  @@index([userId])
  @@index([compromisedAt])
  @@map("token_families")
}

model DeviceSession {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @map("user_id") @db.Uuid
  tokenFamilyId            String               @map("token_family_id") @db.Uuid
  refreshTokenHash         String               @map("refresh_token_hash")
  previousRefreshTokenHash String?              @map("previous_refresh_token_hash")
  deviceName               String?              @map("device_name")
  deviceType               DeviceType           @default(unknown) @map("device_type")
  ipAddress                String?              @map("ip_address")
  userAgent                String?              @map("user_agent")
  sessionVersion           Int                  @map("session_version")
  permissionsVersion       Int                  @map("permissions_version")
  lastUsedAt               DateTime?            @map("last_used_at")
  revokedAt                DateTime?            @map("revoked_at")
  revokedReason            SessionRevokeReason? @map("revoked_reason")
  expiresAt                DateTime             @map("expires_at")
  createdAt                DateTime             @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily TokenFamily @relation(fields: [tokenFamilyId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([tokenFamilyId])
  @@index([previousRefreshTokenHash])
  @@map("device_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ADR-022: stages an incomplete Customer registration (username + canonical
// phone submitted, OTP issued) before any User row exists. Never a child of
// User (none exists yet) - promoted into a real User row only on successful
// COMPLETE. A dedicated table, not a generalization of EmailVerificationToken
// (DECISIONS.md ADR-022, "Alternatives Considered": a 6-digit OTP has a
// materially different entropy/attempt-limiting profile than a 256-bit
// opaque token). Unique on phone enforces Decision #18's "at most one active
// pending registration per canonical phone" invariant at the database level,
// not only in application code - a repeated START updates this same row
// (new codeHash/codeExpiresAt, incorrectAttemptCount reset to 0) rather than
// inserting a second one, and two concurrent STARTs for the same phone race
// on this same unique constraint so only one can ever succeed.
model PendingCustomerRegistration {
  id                    String    @id @default(uuid()) @db.Uuid
  username              String    @map("username")
  phone                 String    @map("phone")
  codeHash              String    @map("code_hash")
  codeExpiresAt         DateTime  @map("code_expires_at")
  incorrectAttemptCount Int       @default(0) @map("incorrect_attempt_count")
  verifiedAt            DateTime? @map("verified_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([phone])
  @@unique([username])
  @@map("pending_customer_registrations")
}

// ADR-022 Decision #16: Customer phone/WhatsApp password-recovery challenge.
// Unlike PendingCustomerRegistration, this always references an EXISTING
// User (a Customer recovering an account that already exists), so it is
// shaped like PasswordResetToken (userId FK) plus the OTP fields already
// frozen for registration, rather than like a new-registration record -
// mirrors this repository's existing precedent of EmailVerificationToken and
// PasswordResetToken being kept as separate, purpose-specific tables rather
// than one generalized table. Never used by, or for, Restaurant Owner/staff
// recovery, which keeps PasswordResetToken unchanged.
model CustomerPasswordResetToken {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  codeHash              String    @map("code_hash")
  codeExpiresAt         DateTime  @map("code_expires_at")
  incorrectAttemptCount Int       @default(0) @map("incorrect_attempt_count")
  verifiedAt            DateTime? @map("verified_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_password_reset_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  identifier    String
  ipAddress     String   @map("ip_address")
  success       Boolean
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([identifier])
  @@index([createdAt])
  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model UserConsent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  consentType  ConsentType @map("consent_type")
  termsVersion String      @map("terms_version")
  consentedAt  DateTime    @map("consented_at")
  ipAddress    String      @map("ip_address")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

model PlatformAdmin {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @unique @map("user_id") @db.Uuid
  // M5 remediation: no column default (fail closed, least privilege) - every
  // INSERT must set this explicitly. Pre-existing rows were backfilled to
  // PlatformAdmin by the migration that first added this column (see that
  // migration's own comment); the default was dropped in a second, later
  // migration once the backfill had already applied.
  role      PlatformAdminRole
  createdAt DateTime          @default(now()) @map("created_at")
  revokedAt DateTime?         @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Restaurant structure (foundation — no business data seeded)
// ---------------------------------------------------------------------------

model Restaurant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  slug           String
  logoId         String?   @map("logo_id") @db.Uuid
  coverImageId   String?   @map("cover_image_id") @db.Uuid
  description    String?
  cuisineType    String?   @map("cuisine_type")
  averageRating  Decimal?  @map("average_rating") @db.Decimal(3, 2)
  priceLevel     Int?      @map("price_level")
  status         String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches           Branch[]
  employees          Employee[]
  favorites          Favorite[]
  settings           RestaurantSettings?
  workingHours       WorkingHours[]
  gallery            RestaurantGallery[]
  cuisineCategories  RestaurantCuisineCategory[]
  occasionCategories RestaurantOccasionCategory[]
  reservations       Reservation[]
  waitlistEntries    ReservationWaitlistEntry[]
  reviews            Review[]
  offers             Offer[]
  usage              RestaurantUsage?
  conversations      Conversation[]
  menus              Menu[]

  @@index([organizationId])
  @@index([slug])
  @@index([name])
  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// Restaurant Settings (Phase 4.2 — Restaurant Module, DATABASE_SCHEMA.md
// "Restaurant Settings"). Tenant-owned transitively via restaurantId ->
// Restaurant.organizationId, not directly - deliberately NOT added to
// withTenantScoping's DIRECT_TENANT_OWNED_MODELS (see that extension's own
// doc comment: relation-path enforcement is deferred to whichever phase
// implements the first consuming repository; enforced at the application
// layer instead - every use case resolves the parent Restaurant through the
// already-tenant-scoped RestaurantRepository first. See
// PrismaRestaurantSettingsRepository's own doc comment.
//
// Phase 7.6 (Operational Signals, ADR-019) adds
// reservationReminderMinutesBefore/lateArrivalGraceMinutes - configuration
// for the Reminder/Late-Arrival BullMQ jobs scheduled alongside every
// Approved reservation. Both are plain per-restaurant tuning knobs, exactly
// like pendingReservationTimeoutMinutes/cancellationWindowMinutes above.
// ---------------------------------------------------------------------------

model RestaurantSettings {
  id                                String   @id @default(uuid()) @db.Uuid
  restaurantId                      String   @unique @map("restaurant_id") @db.Uuid
  reservationIntervalMinutes        Int      @default(30) @map("reservation_interval_minutes")
  maxGuestsPerReservation           Int      @default(20) @map("max_guests_per_reservation")
  cancellationWindowMinutes         Int      @default(60) @map("cancellation_window_minutes")
  pendingReservationTimeoutMinutes  Int      @default(15) @map("pending_reservation_timeout_minutes")
  defaultReservationDurationMinutes Int      @default(90) @map("default_reservation_duration_minutes")
  autoApproval                      Boolean  @default(false) @map("auto_approval")
  timezone                          String   @default("UTC")
  defaultCurrency                   String?  @map("default_currency")
  reservationReminderMinutesBefore  Int      @default(60) @map("reservation_reminder_minutes_before")
  lateArrivalGraceMinutes           Int      @default(15) @map("late_arrival_grace_minutes")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

// ---------------------------------------------------------------------------
// Working Hours (Phase 4.3 — Restaurant Module, DATABASE_SCHEMA.md
// "Working Hours"). Restaurant-level default only per this phase's explicit
// architecture decision (2026-07-16): DOMAIN_MODEL.md's Restaurant Aggregate
// child-entity list is authoritative for aggregate ownership in Phase 4;
// branch-level override (`branchId`, composite override lookup) is deferred
// to Phase 5 when the Branch aggregate/module is implemented and will be
// added as a separate, additive migration then. Tenant-owned transitively
// via restaurantId -> Restaurant.organizationId, not directly - deliberately
// NOT added to withTenantScoping's DIRECT_TENANT_OWNED_MODELS, same pattern
// as RestaurantSettings (see that model's own comment above).
// ---------------------------------------------------------------------------

model WorkingHours {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  openingTime    String   @map("opening_time")
  closingTime    String   @map("closing_time")
  breakStartTime String?  @map("break_start_time")
  breakEndTime   String?  @map("break_end_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("working_hours")
}

// ---------------------------------------------------------------------------
// Restaurant Gallery (Phase 4.4 — Restaurant Module, DATABASE_SCHEMA.md
// "Restaurant Gallery"). Tenant-owned transitively via restaurantId ->
// Restaurant.organizationId, not directly - deliberately NOT added to
// withTenantScoping's DIRECT_TENANT_OWNED_MODELS, same pattern as
// RestaurantSettings/WorkingHours. `fileId` is a plain UUID pointer with no
// Prisma relation to `File` (matching `Restaurant.logoId`/`coverImageId`'s
// existing denormalized-pointer precedent and `File`'s own polymorphic,
// relation-less `ownerId`/`ownerType` design) - the Files aggregate remains
// the sole owner of file metadata/storage location.
// ---------------------------------------------------------------------------

model RestaurantGallery {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  caption      String?
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_gallery")
}

// ---------------------------------------------------------------------------
// Cuisine & Occasion Taxonomy (Phase 4.5 — Restaurant Module, ADR-018,
// DATABASE_SCHEMA.md "Cuisine Categories" / "Restaurant Cuisine Categories" /
// "Occasion Categories" / "Restaurant Occasion Categories"). Reference tables
// are platform-managed, NOT tenant-scoped - shared data seeded at deploy via
// prisma/seed.ts, never created/edited through this module's API. The join
// tables are tenant-owned transitively via restaurantId -> Restaurant, same
// pattern as WorkingHours/RestaurantGallery: NOT added to withTenantScoping's
// DIRECT_TENANT_OWNED_MODELS allowlist - callers must resolve the parent
// Restaurant via the already-tenant-scoped RestaurantRepository first.
// ---------------------------------------------------------------------------

model CuisineCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurants RestaurantCuisineCategory[]

  @@index([isActive])
  @@map("cuisine_categories")
}

model RestaurantCuisineCategory {
  id                String   @id @default(uuid()) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  cuisineCategoryId String   @map("cuisine_category_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisineCategory CuisineCategory @relation(fields: [cuisineCategoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, cuisineCategoryId], map: "restaurant_cuisine_category_unique")
  @@index([cuisineCategoryId])
  @@map("restaurant_cuisine_categories")
}

model OccasionCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurants RestaurantOccasionCategory[]

  @@index([isActive])
  @@map("occasion_categories")
}

model RestaurantOccasionCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  restaurantId       String   @map("restaurant_id") @db.Uuid
  occasionCategoryId String   @map("occasion_category_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  occasionCategory OccasionCategory @relation(fields: [occasionCategoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, occasionCategoryId], map: "restaurant_occasion_category_unique")
  @@index([occasionCategoryId])
  @@map("restaurant_occasion_categories")
}

// ---------------------------------------------------------------------------
// Favorites (Phase 3.3 — User Module, DATABASE_SCHEMA.md "Favorites")
// ---------------------------------------------------------------------------

/**
 * `FavoriteRestaurant` in DOMAIN_MODEL.md (a child entity of the User
 * aggregate). Deliberately NOT added to the tenant-scoping extension's
 * `DIRECT_TENANT_OWNED_MODELS`/relation-path allowlist even though
 * `restaurantId` transitively chains to `Restaurant.organizationId`: every
 * query here is scoped by the caller's own verified `userId` (never by
 * `organizationId`), so the security boundary is "only your own favorites",
 * identical in kind to `PrismaLoginOrganizationReader`'s documented
 * exception. No production code path lets an Organization read another
 * user's Favorites through this model, so there is no cross-tenant leakage
 * surface to enforce against. See `prisma-favorite-restaurant.repository.ts`.
 */
model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("favorites")
}

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  city         String
  district     String?
  address      String
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  countryCode  String    @map("country_code")
  currency     String?
  openingHours Json?     @map("opening_hours")
  timezone     String
  phone        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  restaurant                Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employeeBranchAssignments EmployeeBranchAssignment[]
  workingHours              BranchWorkingHours[]
  floorPlans                FloorPlan[]
  tables                    Table[]
  reservations              Reservation[]
  waitlistEntries           ReservationWaitlistEntry[]
  conversations             Conversation[]

  @@index([restaurantId])
  @@index([city])
  @@index([countryCode])
  @@index([latitude, longitude])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Branch Working Hours (Phase 5.2 — Branch Module, DATABASE_SCHEMA.md "Branch
// Working Hours"). A separate table from `WorkingHours` (Restaurant-level,
// Phase 4.3), not a nullable `branchId` added to it - each aggregate owns its
// own child entity table, avoiding the dual-parent design Phase 4.3 explicitly
// deferred as premature. Tenant-owned transitively via
// branchId -> Branch.restaurantId -> Restaurant.organizationId (two hops), not
// directly - deliberately NOT added to withTenantScoping's
// DIRECT_TENANT_OWNED_MODELS, same pattern as WorkingHours/RestaurantSettings.
// A Branch with zero rows here has no override; whether that means "closed"
// or "falls back to the Restaurant default" is an application-layer/consumer
// decision for a future phase (e.g. Reservation Engine) - out of this phase's
// own CRUD-only scope, same as Restaurant's own WorkingHours precedent.
// ---------------------------------------------------------------------------

model BranchWorkingHours {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  openingTime    String   @map("opening_time")
  closingTime    String   @map("closing_time")
  breakStartTime String?  @map("break_start_time")
  breakEndTime   String?  @map("break_end_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("branch_working_hours")
}

// ---------------------------------------------------------------------------
// Floor Plans (Phase 6.1 — Table Module, DATABASE_SCHEMA.md "Floor Plans").
// Child entity of Branch (not of Table): a Branch may define more than one
// floor layout over time; only one FloorPlan per Branch is `isActive` at a
// time, enforced by a partial unique index on (branchId) WHERE isActive =
// true added by hand in this phase's migration SQL - Prisma's schema DSL
// cannot express a WHERE-filtered unique index. Tenant-owned transitively via
// branchId -> Branch.restaurantId -> Restaurant.organizationId, not directly
// - NOT added to withTenantScoping's DIRECT_TENANT_OWNED_MODELS, same pattern
// as Branch/BranchWorkingHours. `deletedAt` exists because
// DeleteBranchUseCase's cascade (TASKS.md Phase 6.1 decisions #3/#6) must
// soft-delete FloorPlans alongside Tables inside one transaction.
// ---------------------------------------------------------------------------

model FloorPlan {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([branchId])
  @@map("floor_plans")
}

// ---------------------------------------------------------------------------
// Restaurant Tables (Phase 6.1 — Table Module, DATABASE_SCHEMA.md "Restaurant
// Tables"). Child entity of Branch; every Table belongs to exactly one
// FloorPlan (`floorPlanId` required, never nullable - TASKS.md Phase 6.1
// decision #2). Tenant-owned transitively via branchId ->
// Branch.restaurantId -> Restaurant.organizationId - NOT added to
// withTenantScoping's DIRECT_TENANT_OWNED_MODELS, same pattern as Branch.
// `status`/`shape` value sets are intentionally minimal (Phase 6.1
// architecture decision, TASKS.md Phase 6.1 decision #7) - see the
// `TableStatus`/`TableShape` enum doc comments above. `mergeGroupId` is a
// plain nullable UUID value (not a FK - no MergeGroup table exists) - the
// shared identifier of an active Merge/Split (ADR-026) topology group; `null`
// for a table that is not currently merged. `isMergePrimary` marks exactly
// one member of an active `mergeGroupId` group as the Primary Table
// (ADR-026 decision #1, #8) - `Reservation.tableId` for the merged unit is
// always this row's `id`; a database-level CHECK constraint
// (`tables_merge_primary_requires_group_check`) enforces `mergeGroupId IS
// NULL => isMergePrimary = false`, and a partial UNIQUE index
// (`tables_merge_group_one_primary_key`) enforces at most one primary per
// active group (added by hand in this sub-phase's migration SQL - Prisma's
// schema DSL cannot express either). `(branchId, tableNumber)` is a plain
// (non-partial) unique constraint, exactly as DATABASE_SCHEMA.md's index
// table documents it - a soft-deleted table's number is not released for
// reuse.
// ---------------------------------------------------------------------------

model Table {
  id             String      @id @default(uuid()) @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  floorPlanId    String      @map("floor_plan_id") @db.Uuid
  tableNumber    String      @map("table_number")
  capacity       Int
  floor          Int?
  positionX      Float?      @map("position_x")
  positionY      Float?      @map("position_y")
  width          Float?
  height         Float?
  rotation       Float?
  shape          TableShape  @default(Rectangle)
  layer          Int?
  indoor         Boolean     @default(true)
  vip            Boolean     @default(false)
  smoking        Boolean     @default(false)
  status         TableStatus @default(Available)
  mergeGroupId   String?     @map("merge_group_id") @db.Uuid
  isMergePrimary Boolean     @default(false) @map("is_merge_primary")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorPlan    FloorPlan     @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([branchId, tableNumber])
  @@index([branchId])
  @@index([floorPlanId])
  @@index([status])
  @@index([mergeGroupId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Reservations (Phase 7.1 — Reservation Core, DATABASE_SCHEMA.md
// "Reservations"). Scope frozen 2026-07-19/2026-07-20 (TASKS.md's Phase 7 /
// Phase 7.1 decision notes + Phase 7.1 Scope Amendment): Search Availability
// + Create Reservation only. Every reservation this phase produces is
// `status = Pending`, `source = Online`, `userId` set (never
// `reservationGuestId`) - Approval (manual or auto), Reject, Cancel,
// Reschedule, Complete, No-Show, Phone/WalkIn, and Waitlist are later
// sub-phases. `rescheduledFromReservationId` remains a plain nullable UUID
// column with no FK relation yet - mirroring `Table.mergeGroupId`'s own
// precedent for a documented-but-not-yet-built future sub-phase (Phase 7.3's
// possible future "reschedule as a new row" flow - reschedule-as-new-row
// does not exist as a flow yet). `reservationGuestId` gained its real FK to
// `ReservationGuest` in Phase 7.4 (Pre-implementation architecture decisions,
// approved 2026-07-23, decision #12) - see that model below. The
// `EXCLUDE USING gist` constraint (ADR-013) and the reservation-party
// (`userId` XOR `reservationGuestId`) invariant (Phase 7.4 decision #5)
// cannot be expressed in the Prisma schema language itself; both are added
// via raw SQL in the relevant migration (MIGRATION_POLICY.md). Phase 7.5
// (Reservation Waitlist, ADR-019) makes `createdBy` nullable: `null` means
// the Reservation was created by an automatic Waitlist promotion (System
// actor), never a placeholder id - see `ReservationWaitlistEntry` below.
// ---------------------------------------------------------------------------

enum ReservationStatus {
  Pending
  Approved
  Rejected
  Cancelled
  Completed
  Expired
  NoShow
}

enum ReservationSource {
  Online
  Phone
  WalkIn
  Staff
  WaitlistConversion
}

model Reservation {
  id                           String            @id @default(uuid()) @db.Uuid
  userId                       String?           @map("user_id") @db.Uuid
  reservationGuestId           String?           @map("reservation_guest_id") @db.Uuid
  restaurantId                 String            @map("restaurant_id") @db.Uuid
  branchId                     String            @map("branch_id") @db.Uuid
  tableId                      String            @map("table_id") @db.Uuid
  reservationDate              DateTime          @map("reservation_date") @db.Date
  reservationStartTime         DateTime          @map("reservation_start_time") @db.Timestamptz
  reservationEndTime           DateTime          @map("reservation_end_time") @db.Timestamptz
  guests                       Int
  status                       ReservationStatus @default(Pending)
  source                       ReservationSource @default(Online)
  notes                        String?
  createdBy                    String?           @map("created_by") @db.Uuid
  approvedBy                   String?           @map("approved_by") @db.Uuid
  approvedAt                   DateTime?         @map("approved_at")
  cancelledAt                  DateTime?         @map("cancelled_at")
  completedAt                  DateTime?         @map("completed_at")
  noShowAt                     DateTime?         @map("no_show_at")
  lateArrivalNotifiedAt        DateTime?         @map("late_arrival_notified_at")
  tableReadyNotifiedAt         DateTime?         @map("table_ready_notified_at")
  rescheduledFromReservationId String?           @map("rescheduled_from_reservation_id") @db.Uuid
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")

  restaurant       Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch           Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table            Table                     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  user             User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservationGuest ReservationGuest?         @relation(fields: [reservationGuestId], references: [id], onDelete: Restrict)
  history          ReservationHistory[]
  waitlistEntry    ReservationWaitlistEntry?
  review           Review?
  conversations    Conversation[]

  @@index([reservationDate])
  @@index([tableId])
  @@index([branchId])
  @@index([status])
  @@index([branchId, reservationDate, status])
  @@index([tableId, reservationDate, reservationStartTime])
  @@index([userId, createdAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Reservation Guests (Phase 7.4 — Phone & Walk-In Reservations,
// DATABASE_SCHEMA.md "Reservation Guests"). Represents the person a
// reservation is for when no registered User account exists (Phone/WalkIn
// sources). Dependent entity of the Reservation Aggregate, not a standalone
// aggregate (Phase 7.4 decision #4) - persisted via its own repository
// mirroring `ReservationHistory`'s own precedent, but with no lifecycle
// independent of the Reservation(s) that reference it. `anonymizedAt`
// exists so the row is anonymization-compatible (Phase 7.4 decision #13);
// no erasure subsystem is implemented by this migration.
// ---------------------------------------------------------------------------

model ReservationGuest {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name")
  phone        String
  email        String?
  anonymizedAt DateTime? @map("anonymized_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reservations    Reservation[]
  waitlistEntries ReservationWaitlistEntry[]

  @@index([phone])
  @@map("reservation_guests")
}

// ---------------------------------------------------------------------------
// Reservation Waitlist Entries (Phase 7.5 — Reservation Waitlist, ADR-019,
// DATABASE_SCHEMA.md "Reservation Waitlist Entries"). Guests who cannot be
// seated immediately join a branch-scoped, date-scoped waitlist. Distinct
// from `Reservations` - no table assignment until promoted
// (`WaitlistPromotionService`). `preferredDate` AND `preferredTimeFrom` are
// both required at the Phase 7.5 Join application boundary (Phase 7.5
// architecture freeze, final promotion-slot-semantics decision,
// 2026-07-24): `preferredTimeFrom` is the authoritative requested
// Reservation start time-of-day on promotion - no longer a merely "soft"
// preference. `preferredTimeTo` remains optional/non-authoritative,
// filtering metadata only, never used to construct a Reservation. The
// `userId` XOR `reservationGuestId` CHECK constraint mirrors `Reservation`'s
// own (Phase 7.4 decision #5) and, like that one, cannot be expressed in the
// Prisma schema language - added via raw SQL in the Phase 7.5 migration,
// together with the partial-unique active-queue-position index scoped by
// `(branchId, preferredDate, position)` (queue scope per the Phase 7.5
// freeze item 13). Phase 7.5 tenancy correction (2026-07-24, forward
// corrective migration `phase_7_5_1_waitlist_remove_organization_id`):
// deliberately carries NO direct `organizationId` column, unlike this
// model's own originally-documented (pre-implementation) shape - a required
// direct `organizationId` is structurally incompatible with Customer-facing
// Join, which has no bound `TenantContext.organizationId` to populate it
// with, and resolving it via `RestaurantRepository` would throw
// `TenantContextMissingException` (`Restaurant` is a
// `DIRECT_TENANT_OWNED_MODEL`, fail-closed with no context bound) or require
// bypassing tenant scoping entirely - neither acceptable. Tenant ownership is
// resolved transitively (`branchId -> Branch.restaurantId ->
// Restaurant.organizationId`), exactly like `Reservation` itself already
// does, not registered in `withTenantScoping`'s `DIRECT_TENANT_OWNED_MODELS`.
// ---------------------------------------------------------------------------

enum WaitlistStatus {
  Waiting
  Notified
  Converted
  Cancelled
  Expired
}

model ReservationWaitlistEntry {
  id                     String         @id @default(uuid()) @db.Uuid
  restaurantId           String         @map("restaurant_id") @db.Uuid
  branchId               String         @map("branch_id") @db.Uuid
  userId                 String?        @map("user_id") @db.Uuid
  reservationGuestId     String?        @map("reservation_guest_id") @db.Uuid
  partySize              Int            @map("party_size")
  preferredDate          DateTime       @map("preferred_date") @db.Date
  preferredTimeFrom      DateTime       @map("preferred_time_from") @db.Time
  preferredTimeTo        DateTime?      @map("preferred_time_to") @db.Time
  status                 WaitlistStatus @default(Waiting)
  position               Int
  convertedReservationId String?        @unique @map("converted_reservation_id") @db.Uuid
  notifiedAt             DateTime?      @map("notified_at")
  expiresAt              DateTime       @map("expires_at")
  notes                  String?
  createdBy              String         @map("created_by") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deletedAt              DateTime?      @map("deleted_at")

  restaurant           Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch               Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user                 User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservationGuest     ReservationGuest? @relation(fields: [reservationGuestId], references: [id], onDelete: Restrict)
  convertedReservation Reservation?      @relation(fields: [convertedReservationId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([status])
  @@index([branchId, preferredDate, status])
  @@index([branchId, status, position])
  @@index([userId])
  @@index([reservationGuestId])
  @@map("reservation_waitlist_entries")
}

// ---------------------------------------------------------------------------
// Reservation History (Phase 7.3 — Reservation Lifecycle, DATABASE_SCHEMA.md
// "Reservation History"). Introduced by Phase 7.3 - not created by Phase
// 7.1/7.2, which retain their existing AuditingEventPublisher-only auditing
// unchanged. Rows are created by Cancel, Reschedule, Complete, NoShow, and
// Expire only. `oldTableId`/`newTableId` are populated exclusively on a
// table-changing Reschedule (ADR-023) - null for every other action and for
// a same-table reschedule.
// ---------------------------------------------------------------------------

model ReservationHistory {
  id                       String            @id @default(uuid()) @db.Uuid
  reservationId            String            @map("reservation_id") @db.Uuid
  oldStatus                ReservationStatus @map("old_status")
  newStatus                ReservationStatus @map("new_status")
  oldReservationDate       DateTime?         @map("old_reservation_date") @db.Date
  oldReservationStartTime  DateTime?         @map("old_reservation_start_time") @db.Timestamptz
  newReservationDate       DateTime?         @map("new_reservation_date") @db.Date
  newReservationStartTime  DateTime?         @map("new_reservation_start_time") @db.Timestamptz
  oldTableId               String?           @map("old_table_id") @db.Uuid
  newTableId               String?           @map("new_table_id") @db.Uuid
  withinCancellationWindow Boolean?          @map("within_cancellation_window")
  changedBy                String?           @map("changed_by") @db.Uuid
  changedAt                DateTime          @map("changed_at")
  reason                   String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("reservation_history")
}

// ---------------------------------------------------------------------------
// Reviews (Phase 10 — Reviews, architecture frozen 2026-07-26,
// DATABASE_SCHEMA.md "Reviews" / "Review Images" / "Restaurant Replies").
// `Review.restaurantId` is the sole tenant-resolution hop
// (`Review.restaurantId -> Restaurant.organizationId`) - `Review` carries no
// direct `organizationId` column and is NOT added to `withTenantScoping`'s
// `DIRECT_TENANT_OWNED_MODELS` (same transitively-tenant-owned pattern as
// `Reservation`/`ReservationWaitlistEntry`). `Review.userId` is a separate,
// ownership-authorization concern spanning organizations exactly like
// `Reservation.userId` - the two are independent axes (TENANCY.md). `rating
// BETWEEN 1 AND 5` cannot be expressed in the Prisma schema language - added
// via a raw SQL CHECK constraint in this phase's migration, mirroring
// ADR-013's own exclusion-constraint precedent. Reviews are immutable after
// creation (no edit endpoint, no `ReviewUpdated` event) and soft-deleted only
// (ADR-010) - `reservationId`'s unique index is plain, not partial/
// conditional on `deletedAt`: deleting a Review never frees its Reservation
// for resubmission (owner-approved Phase 10 freeze). `ReviewImage.fileId` is
// a plain UUID pointer with no Prisma relation to `File`, matching
// `RestaurantGallery.fileId`'s existing precedent - the Files aggregate
// remains the sole owner of file metadata/storage location.
// `RestaurantReply.repliedByUserId` (never an `employeeId`) corrects the
// pre-freeze schema sketch's documentation defect - "Restaurant Owner" is the
// `OrganizationMember.Owner` role, a `User`-backed actor with no `Employee`
// row (AUTHORIZATION_ARCHITECTURE.md §10); Employees do not reply to Reviews
// in Phase 10 and no new permission slug was introduced.
// ---------------------------------------------------------------------------

model Review {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  restaurantId  String    @map("restaurant_id") @db.Uuid
  reservationId String    @unique @map("reservation_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  images ReviewImage[]
  reply  RestaurantReply?

  @@index([restaurantId])
  @@index([userId])
  @@map("reviews")
}

model ReviewImage {
  id        String    @id @default(uuid()) @db.Uuid
  reviewId  String    @map("review_id") @db.Uuid
  fileId    String    @map("file_id") @db.Uuid
  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model RestaurantReply {
  id              String   @id @default(uuid()) @db.Uuid
  reviewId        String   @unique @map("review_id") @db.Uuid
  repliedByUserId String   @map("replied_by_user_id") @db.Uuid
  comment         String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  review        Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  repliedByUser User   @relation(fields: [repliedByUserId], references: [id], onDelete: Restrict)

  @@map("restaurant_replies")
}

// ---------------------------------------------------------------------------
// Offers (Phase 11, architecture frozen 2026-07-28, implemented 2026-07-28,
// TASKS.md "Phase 11 — Offers: Pre-implementation architecture decisions").
// Single generic Offer aggregate covers Promotions/Coupons/Events (`type`
// discriminator, display-only - no redemption engine, no behavioral
// branching by type). Transitively tenant-owned via restaurantId ->
// Restaurant.organizationId, same pattern as Review/RestaurantGallery - NOT
// added to withTenantScoping's DIRECT_TENANT_OWNED_MODELS, no
// organizationId column. Content editable only while status = Draft;
// Published/Expired are immutable. Published -> Expired is a BullMQ-
// scheduled, CAS-guarded transition (OfferExpirationQueue), never a lazy/
// computed status.
// ---------------------------------------------------------------------------

enum OfferType {
  Promotion
  Coupon
  Event
}

enum OfferDiscountType {
  Percentage
  FixedAmount
}

enum OfferStatus {
  Draft
  Published
  Expired
}

model Offer {
  id            String            @id @default(uuid()) @db.Uuid
  restaurantId  String            @map("restaurant_id") @db.Uuid
  type          OfferType
  title         String
  description   String
  discountType  OfferDiscountType @map("discount_type")
  discountValue Decimal           @map("discount_value") @db.Decimal(10, 2)
  startsAt      DateTime          @map("starts_at")
  endsAt        DateTime          @map("ends_at")
  status        OfferStatus       @default(Draft)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Menu Management (Phase 18, architecture frozen 2026-08-02, ADR-031;
// ownership/availability/isFeatured corrected 2026-08-03, ADR-032). Seven
// models, all transitively tenant-owned via restaurantId ->
// Restaurant.organizationId (same pattern as Offer/Review/Branch) - none
// added to withTenantScoping's DIRECT_TENANT_OWNED_MODELS. MenuCategory/
// MenuItem/MenuItemOptionGroup/MenuItemOption/MenuItemAddOn/
// MenuItemAvailability all additionally denormalize restaurantId directly
// (not only their immediate parent FK), mirroring Table's own
// floorPlanId/branchId denormalization, so every tenancy resolution stays a
// single hop through RestaurantRepository regardless of nesting depth.
//
// ADR-032 supersedes ADR-031's original singleton `@@unique([restaurantId])`
// on Menu: a Restaurant now owns 1:N Menus, with exactly one non-deleted
// Menu marked isDefault - enforced by a hand-written partial unique index
// (menus_restaurant_one_default_key, added in this migration's raw SQL,
// mirroring ADR-026's tables_merge_group_one_primary_key mechanism exactly,
// since Prisma's schema DSL cannot express a partial unique index).
//
// MenuItem.scheduleJson (ADR-031's original design) is replaced by the
// relational MenuItemAvailability table (ADR-032) - the actual repeated
// day-of-week/time-window convention in this codebase (WorkingHours,
// BranchWorkingHours), not the dead-code Branch.openingHours Json precedent
// ADR-031 had mistakenly cited (see DATABASE_SCHEMA.md's Branch section).
// No deletedAt on MenuItemAvailability - matching WorkingHours/
// BranchWorkingHours, availability windows are whole-set replaced, not
// individually soft-deleted.
// ---------------------------------------------------------------------------

enum MenuItemAvailabilityMode {
  Always
  Unavailable
  Scheduled
}

enum MenuItemDietaryLabel {
  Vegetarian
  Vegan
  Halal
  GlutenFree
  DairyFree
}

model Menu {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String    @default("Main Menu")
  active       Boolean   @default(true)
  isDefault    Boolean   @default(false) @map("is_default")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

